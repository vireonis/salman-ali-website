# ── Supabase (public — safe for client bundle) ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ── Supabase (SECRET — server-only, NEVER prefix with NEXT_PUBLIC_) ─────────
# Used only inside server-side code (API routes, server actions). Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Site ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ── AI Publishing API (SECRET) ───────────────────────────────────────────
# Long random string. Generate with: openssl rand -hex 32
# Sent by external clients (e.g. Claude Code) as: Authorization: Bearer <value>
AI_PUBLISHING_API_KEY=generate-a-long-random-secret-here
